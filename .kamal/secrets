# Secrets Kamal passes to the containers, read from your environment (or a password manager:
# see https://kamal-deploy.org/docs/commands/secrets/). Never put a value in this file.
#
# SECRET_KEY_BASE      bin/rails secret
# POSTGRES_PASSWORD    any long random string; set it once, the database keeps it
# PASSPHRASE           encrypts the backups; losing it means losing them

SECRET_KEY_BASE=$SECRET_KEY_BASE
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
SMTP_PASSWORD=$SMTP_PASSWORD
S3_ACCESS_KEY_ID=$BACKUP_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=$BACKUP_S3_SECRET_ACCESS_KEY
PASSPHRASE=$BACKUP_PASSPHRASE
