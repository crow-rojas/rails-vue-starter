{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "app/javascript/entrypoints/*.{ts,css}",
    "app/javascript/pages/**/*.vue",
    // The vendored shadcn-vue kit and its `utils` alias (components.json): kept whole, used or not.
    "app/javascript/components/ui/**/*.{ts,vue}",
    "app/javascript/lib/utils.ts",
    // Ambient declarations: Inertia's flash and page props are typed here.
    "app/javascript/types/*.d.ts",
  ],
  "project": ["app/javascript/**/*.{ts,vue,css}"],
  "ignore": ["app/javascript/routes/**"],
  // Loaded from node_modules by the Ruby system tests (assert_accessible), which knip doesn't read.
  "ignoreDependencies": ["axe-core"],
}
