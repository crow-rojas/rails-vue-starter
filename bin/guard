#!/usr/bin/env ruby
# Fails when a change weakens the test suite or rewrites a shipped migration.
# A human can let one branch through with a commit trailer:
#   Guard-Override: tests <reason>   or   Guard-Override: migrations <reason>

def git(*args) = IO.popen([ "git", *args ], &:read).strip

TEST_PATTERN = /^\s*(test\s+["']|def test_)/

def test_count(ref = nil)
  files = ref ? git("ls-tree", "-r", "--name-only", ref, "test").lines(chomp: true) : Dir["test/**/*"]
  files.grep(/_test\.rb\z/).sum do |file|
    source = ref ? git("show", "#{ref}:#{file}") : File.read(file)
    source.scan(TEST_PATTERN).size
  end
end

base_ref = %w[origin/main main].find { |ref| system("git", "rev-parse", "--verify", "-q", ref, out: File::NULL) }
abort "guard: no main branch to compare against" unless base_ref
base = git("merge-base", "HEAD", base_ref)
overrides = git("log", "--format=%(trailers:key=Guard-Override,valueonly)", "#{base}..HEAD").lines.filter_map { it.split.first }
allow_tests = overrides.include?("tests")
allow_migrations = overrides.include?("migrations")
failures = []

before, after = test_count(base), test_count
if after < before && !allow_tests
  failures << "the number of tests went down (#{before} -> #{after})"
end

added_skips = git("diff", base, "--unified=0", "--", "test").lines.grep(/^\+\s*skip\b/)
if added_skips.any? && !allow_tests
  failures << "new skip calls in tests:\n#{added_skips.join}"
end

changed_migrations = git("diff", "--name-only", "--diff-filter=MDR", base, "--", "db/migrate").lines(chomp: true)
if changed_migrations.any? && !allow_migrations
  failures << "migrations already on main were changed; add a new one instead:\n#{changed_migrations.join("\n")}"
end

if failures.any?
  warn failures.map { |failure| "guard: #{failure}" }.join("\n")
  exit 1
end
