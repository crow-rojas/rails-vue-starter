#!/usr/bin/env ruby
require "digest"
require "fileutils"
require "socket"

APP_ROOT = File.expand_path("..", __dir__)

def system!(*args)
  system(*args, exception: true)
end

def port_taken?(port)
  TCPSocket.new("127.0.0.1", port).close
  true
rescue Errno::ECONNREFUSED
  false
end

# Ports written in the other worktrees' .env files, so a stopped sibling keeps its ports.
def sibling_ports
  `git worktree list --porcelain 2>/dev/null`.scan(/^worktree (.+)$/).flatten.flat_map do |dir|
    env = File.join(dir, ".env")
    File.exist?(env) ? File.read(env).scan(/^(?:DB_)?PORT=(\d+)/).flatten.map(&:to_i) : []
  end
end

FileUtils.chdir APP_ROOT do
  # This script is a way to set up or update your development environment automatically.
  # This script is idempotent, so that you can run it at any time and get an expectable outcome.
  # Add necessary setup steps to this file.

  puts "== Installing dependencies =="
  system("bundle check") || system!("bundle install")
  system! "corepack enable pnpm"
  system! "pnpm install"
  system! "bundle exec lefthook install"

  # puts "\n== Copying sample files =="
  # unless File.exist?("config/database.yml")
  #   FileUtils.cp "config/database.yml.sample", "config/database.yml"
  # end

  unless File.exist?(".env")
    puts "\n== Writing .env =="
    reserved = sibling_ports
    db_port = ((5432..5532).to_a - reserved).find { |p| !port_taken?(p) }
    web_port = ((3000..3100).to_a - reserved).find { |p| !port_taken?(p) }
    project = "#{File.basename(APP_ROOT).downcase.gsub(/[^a-z0-9_-]/, "-")}-#{Digest::SHA256.hexdigest(APP_ROOT)[0, 8]}"
    env = File.read(".env.example").sub(/^DB_PORT=.*/, "DB_PORT=#{db_port}").sub(/^PORT=.*/, "PORT=#{web_port}")
    File.write(".env", "#{env}\n# Keeps this checkout's Postgres container and volume apart from checkouts with the same folder name.\nCOMPOSE_PROJECT_NAME=#{project}\n")
  end

  puts "\n== Starting Postgres =="
  system! "docker compose up --detach --wait db"

  puts "\n== Preparing database =="
  system! "bin/rails db:prepare"
  system! "bin/rails db:reset" if ARGV.include?("--reset")

  unless ARGV.include?("--skip-server")
    # Only before starting the server: bin/ci runs --skip-server on every push, under whatever else uses log/ and tmp/.
    puts "\n== Removing old logs and tempfiles =="
    system! "bin/rails log:clear tmp:clear"

    puts "\n== Starting development server =="
    STDOUT.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
