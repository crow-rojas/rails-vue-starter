#!/usr/bin/env sh
# gitleaks from PATH, or its pinned image when it is not installed.
# The shared git dir is mounted too, so the image can follow a worktree's .git file.
if command -v gitleaks >/dev/null 2>&1; then exec gitleaks "$@"; fi
c=$(git rev-parse --path-format=absolute --git-common-dir)
exec docker run --rm -v "$PWD:$PWD" -v "$c:$c" -w "$PWD" ghcr.io/gitleaks/gitleaks:v8.30.1 "$@"
