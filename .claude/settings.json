{
  "permissions": {
    "allow": [
      "Bash(bin/check)",
      "Bash(bin/ci)",
      "Bash(bin/rails test*)",
      "Bash(pnpm lint)",
      "Bash(pnpm check)",
      "Bash(pnpm format)",
      "Bash(bin/rubocop*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./config/master.key)",
      "Read(./config/credentials/*.key)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(* --no-veri*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n*)",
      "Bash(*LEFTHOOK=0*)",
      "Bash(*LEFTHOOK_EXCLUDE*)",
      "Bash(*core.hooksPath*)",
      "Bash(*lefthook uninstall*)",
      "Bash(git push -uf *)",
      "Bash(git push * +*)",
      "Bash(*Guard-Override*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited-file",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-on-stop",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
